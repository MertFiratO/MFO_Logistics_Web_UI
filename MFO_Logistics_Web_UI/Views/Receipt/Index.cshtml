@model MFO_Logistics_Web_UI.Models.ViewModels.ReceiptSearchViewModel


@{
    ViewData["Title"] = "Receipt Report";
}


<link rel="stylesheet" href="https://cdn.datatables.net/2.0.8/css/dataTables.bootstrap5.min.css" />


<h2>Receipt Report</h2>

<form asp-controller="Receipt" asp-action="Index" method="post" class="card p-3 mb-4">

    <div class="row">

        <div class="col-md-2">
            <label class="form-label">BaşlangıçTarihi</label>
            <input asp-for="Filter.CreateDate" type="date" class="form-control" />
        </div>

        <div class="col-md-2">
            <label class="form-label">BitişTarihi</label>
            <input asp-for="Filter.CreateDate2" type="date" class="form-control" />
        </div>

        <div class="col-md-2">
            <label class="form-label">TeslimAlma Kodu</label>
            <input asp-for="Filter.ReceiptCode" class="form-control" />
        </div>

        <div class="col-md-3">
            <label class="form-label">Depositor Adı</label>
            <input asp-for="Filter.DepositorName" class="form-control" />
        </div>

        <div class="col-md-3">
            <label class="form-label">Lojistik Adı</label>
            <input asp-for="Filter.LogisticName" class="form-control" />
        </div>

    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-dark">Ara</button>
        <a asp-controller="Receipt" asp-action="Index" class="btn btn-secondary">Temizle</a>
    </div>

</form>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

@if (!Model.IsSearched)
{
    <div class="alert alert-info">
        Filtre girip Ara butonuna basınız.
    </div>
}
else if (Model.Receipts == null || !Model.Receipts.Any())
{
    <div class="alert alert-warning">
        Kayıt bulunamadı.
    </div>
}
else
{
    <table id="receiptTable" class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Receipt Code</th>
                <th>Logistic</th>
                <th>Depositor</th>
                <th>Create Date</th>
                <th>Status</th>
                <th>Create User</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model.Receipts)
            {
                <tr>
                    <td>@item.ReceiptCode</td>
                    <td>@item.LogisticName</td>
                    <td>@item.DepositorName</td>
                    <td>@(item.CreateDate.ToString("dd.MM.yyyy"))</td>
                    <td>@item.ReceiptStatusName</td>
                    <td>@item.CreateUser</td>
                </tr>
            }
        </tbody>
    </table>
}

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <script src="https://cdn.datatables.net/2.0.8/js/dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/2.0.8/js/dataTables.bootstrap5.min.js"></script>

    <script>
        $(document).ready(function () {

        console.log("Receipt Index script çalıştı");

        if ($('#receiptTable').length) {
        console.log("Tablo bulundu");

        $('#receiptTable').DataTable({
        pageLength: 10,
        lengthMenu: [10, 25, 50, 100]
        });
        }
        else {
        console.log("Tablo bulunamadı");
        }
        });
    </script>
}