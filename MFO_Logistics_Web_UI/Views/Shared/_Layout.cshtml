<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - MFO Logistics</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>

    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container-fluid">

            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                MFO Logistics
            </a>

            <div class="collapse navbar-collapse">
                <ul class="navbar-nav me-auto">

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Receipt" asp-action="Index">
                            Receipt
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Stock" asp-action="Index">
                            Stock
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Orders" asp-action="Index">
                            Orders
                        </a>
                    </li>

                </ul>

                <a class="btn btn-outline-light" asp-controller="Auth" asp-action="Logout">
                    Logout
                </a>
            </div>

        </div>
    </nav>

    <main role="main">
        @RenderBody()
    </main>

</body>
</html>